 {
  "name": "a slug change leaves a redirect from the old address",
  "feature": "redirects",
  "requiresFeatures": [
   "update"
  ],
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-r-1",
     "title": "Warn {{run}}-r-1",
     "markdown": "## Part\n\nText.",
     "status": "published",
     "slug": "{{run}}-old-name"
    },
    "captureBodyAs": "r1"
   },
   {
    "method": "PATCH",
    "endpoint": "/api/content/{{r1.id}}",
    "body": {
     "slug": "{{run}}-new-name"
    },
    "captureBodyAs": "r1new"
   }
  ],
  "method": "GET",
  "endpoint": "/api/redirects?kind=post&slug={{run}}-old-name",
  "expect": {
   "status": 200,
   "path": {
    "id": "{{r1new.id}}",
    "url": "{{r1new.url}}",
    "kind": "post",
    "slug": "{{run}}-old-name"
   }
  }
 },
