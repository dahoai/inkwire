 {
  "name": "list returns created entries with summaries",
  "feature": "list",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-l-1",
     "title": "Alpha one",
     "markdown": "alpha body {{run}}",
     "status": "published"
    }
   },
   {
    "body": {
     "external_id": "{{run}}-l-2",
     "title": "Beta two",
     "markdown": "{{run}}-beta-body"
    }
   }
  ],
  "method": "GET",
  "endpoint": "/api/content?limit=2",
  "expect": {
   "status": 200,
   "path": {
    "items.0.title": "present",
    "items.0.id": "present",
    "items.0.slug": "present",
    "items.0.url": "present",
    "items.0.status": "present",
    "items.0.kind": "present",
    "items.1.id": "present",
    "items.2": "absent",
    "next_cursor": "present"
   }
  }
 },
 {
  "name": "list cursor pages forward",
  "feature": "list",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-p-1",
     "title": "P one",
     "markdown": "x"
    }
   },
   {
    "body": {
     "external_id": "{{run}}-p-2",
     "title": "P two",
     "markdown": "x"
    }
   },
   {
    "method": "GET",
    "endpoint": "/api/content?limit=1",
    "captureBodyAs": "page1"
   }
  ],
  "method": "GET",
  "endpoint": "/api/content?limit=1&cursor={{page1.next_cursor}}",
  "expect": {
   "status": 200,
   "path": {
    "items.0.id": "present",
    "items.1": "absent"
   }
  }
 },
 {
  "name": "list is newest first",
  "feature": "list",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-o-1",
     "title": "Order older",
     "markdown": "{{run}}-order older",
     "status": "published"
    }
   },
   {
    "sleepMs": 1100
   },
   {
    "body": {
     "external_id": "{{run}}-o-2",
     "title": "Order newer",
     "markdown": "{{run}}-order newer",
     "status": "published"
    }
   }
  ],
  "method": "GET",
  "endpoint": "/api/content?search={{run}}-order&limit=10",
  "expect": {
   "status": 200,
   "path": {
    "items.0.external_id": "{{run}}-o-2",
    "items.1.external_id": "{{run}}-o-1"
   }
  }
 },
 {
  "name": "list search matches markdown",
  "feature": "list",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-needle-ext",
     "title": "Needle entry",
     "markdown": "unique token {{run}}-needle inside"
    }
   }
  ],
  "method": "GET",
  "endpoint": "/api/content?search={{run}}-needle",
  "expect": {
   "status": 200,
   "path": {
    "items.0.external_id": "{{run}}-needle-ext"
   }
  }
 },
 {
  "name": "list filter by external_id",
  "feature": "list",
  "method": "GET",
  "endpoint": "/api/content?external_id={{run}}-needle-ext",
  "expect": {
   "status": 200,
   "path": {
    "items.0.external_id": "{{run}}-needle-ext",
    "items.1": "absent"
   }
  }
 },
 {
  "name": "list filter by status draft",
  "feature": "list",
  "method": "GET",
  "endpoint": "/api/content?status=draft&search={{run}}-beta",
  "expect": {
   "status": 200,
   "path": {
    "items.0.title": "Beta two",
    "items.1": "absent"
   }
  }
 },
 {
  "name": "get returns the full entry with an ETag",
  "feature": "get",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-g-1",
     "title": "Get me",
     "markdown": "original body",
     "excerpt": "Get excerpt",
     "seo": {
      "title": "SEO title",
      "noindex": true
     }
    },
    "captureBodyAs": "g1"
   }
  ],
  "method": "GET",
  "endpoint": "/api/content/{{g1.id}}",
  "captureEtagAs": "g1etag",
  "expect": {
   "status": 200,
   "hasEtag": true,
   "path": {
    "markdown": "original body",
    "title": "Get me",
    "external_id": "{{run}}-g-1",
    "kind": "post",
    "seo.title": "SEO title",
    "seo.noindex": true,
    "seo.description": "Get excerpt"
   }
  }
 },
 {
  "name": "get unknown id -> 404",
  "feature": "get",
  "method": "GET",
  "endpoint": "/api/content/no-such-id-{{run}}",
  "expect": {
   "status": 404,
   "errorCode": "not_found"
  }
 },
 {
  "name": "patch title with If-Match -> 200, full entry back",
  "feature": "update",
  "requiresFeatures": [
   "get"
  ],
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-u-1",
     "title": "Before",
     "markdown": "keep body"
    },
    "captureBodyAs": "u1"
   },
   {
    "method": "GET",
    "endpoint": "/api/content/{{u1.id}}",
    "captureEtagAs": "u1etag"
   }
  ],
  "method": "PATCH",
  "endpoint": "/api/content/{{u1.id}}",
  "headers": {
   "if-match": "{{etag:u1etag}}"
  },
  "body": {
   "title": "After"
  },
  "captureEtagAs": "u1etag2",
  "expect": {
   "status": 200,
   "hasEtag": true,
   "path": {
    "title": "After",
    "markdown": "keep body"
   }
  }
 },
 {
  "name": "patch with the now-stale ETag -> 412",
  "feature": "update",
  "method": "PATCH",
  "endpoint": "/api/content/{{u1.id}}",
  "headers": {
   "if-match": "{{etag:u1etag}}"
  },
  "body": {
   "title": "Racer"
  },
  "expect": {
   "status": 412,
   "errorCode": "stale"
  }
 },
 {
  "name": "patch without If-Match is allowed",
  "feature": "update",
  "method": "PATCH",
  "endpoint": "/api/content/{{u1.id}}",
  "body": {
   "excerpt": "Added excerpt"
  },
  "expect": {
   "status": 200,
   "path": {
    "excerpt": "Added excerpt"
   }
  }
 },
 {
  "name": "patch seo merges per key",
  "feature": "update",
  "requiresFeatures": [
   "get"
  ],
  "method": "PATCH",
  "endpoint": "/api/content/{{u1.id}}",
  "body": {
   "seo": {
    "noindex": true
   }
  },
  "expect": {
   "status": 200
  }
 },
 {
  "name": "patched seo kept the earlier override and added noindex",
  "feature": "get",
  "method": "GET",
  "endpoint": "/api/content/{{u1.id}}",
  "expect": {
   "status": 200,
   "path": {
    "seo.noindex": true
   }
  }
 },
 {
  "name": "patch null clears an optional field",
  "feature": "update",
  "requiresFeatures": [
   "get"
  ],
  "method": "PATCH",
  "endpoint": "/api/content/{{u1.id}}",
  "body": {
   "excerpt": null
  },
  "expect": {
   "status": 200
  }
 },
 {
  "name": "cleared excerpt reads back empty",
  "feature": "get",
  "method": "GET",
  "endpoint": "/api/content/{{u1.id}}",
  "expect": {
   "status": 200,
   "path": {
    "excerpt": "absent"
   }
  }
 },
 {
  "name": "patch cannot change external_id -> 400",
