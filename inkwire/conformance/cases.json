 {
  "name": "list returns created entries with summaries",
  "feature": "list",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-l-1",
     "title": "Alpha one",
     "markdown": "alpha body {{run}}",
     "status": "published"
    }
   },
   {
    "body": {
     "external_id": "{{run}}-l-2",
     "title": "Beta two",
     "markdown": "{{run}}-beta-body"
    }
   }
  ],
  "method": "GET",
  "endpoint": "/api/content?limit=2",
  "expect": {
   "status": 200,
   "path": {
    "items.0.title": "present",
    "items.0.id": "present",
    "items.0.slug": "present",
    "items.0.url": "present",
    "items.0.status": "present",
    "items.0.kind": "present",
    "items.1.id": "present",
    "items.2": "absent",
    "next_cursor": "present"
   }
  }
 },
 {
  "name": "list cursor pages forward",
  "feature": "list",
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-p-1",
     "title": "P one",
     "markdown": "x"
    }
   },
   {
    "body": {
     "external_id": "{{run}}-p-2",
     "title": "P two",
     "markdown": "x"
    }
   },
   {
    "method": "GET",
    "endpoint": "/api/content?limit=1",
    "captureBodyAs": "page1"
   }
  ],
  "method": "GET",
  "endpoint": "/api/content?limit=1&cursor={{page1.next_cursor}}",
  "expect": {
   "status": 200,
   "path": {
    "items.0.id": "present",
    "items.1": "absent"
   }
  }
 },
 {
  "name": "list search matches markdown",
  "feature": "list",
  "setup": [
