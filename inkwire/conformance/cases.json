[
 {
  "name": "create published",
  "auth": true,
  "body": {
   "external_id": "{{run}}-c-1",
   "title": "First",
   "markdown": "# Hi",
   "status": "published"
  },
  "expect": {
   "status": 200,
   "json": {
    "created": true,
    "status": "published",
    "kind": "post"
   },
   "hasUrl": true,
   "hasSlug": true
  }
 },
 {
  "name": "upsert same external_id",
  "auth": true,
  "body": {
   "external_id": "{{run}}-c-1",
   "title": "First edited",
   "markdown": "# Hi again",
   "status": "published"
  },
  "expect": {
   "status": 200,
   "json": {
    "created": false
   }
  }
 },
