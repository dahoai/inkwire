   "status": 404,
   "errorCode": "not_found"
  }
 },
 {
  "name": "delete unknown id -> 404",
  "feature": "delete",
  "method": "DELETE",
  "endpoint": "/api/content/no-such-id-{{run}}",
  "expect": {
   "status": 404,
   "errorCode": "not_found"
  }
 },
