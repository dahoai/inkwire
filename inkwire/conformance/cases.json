 {
  "name": "delete with If-Match -> 200",
  "feature": "delete",
  "requiresFeatures": [
   "get"
  ],
  "setup": [
   {
    "body": {
     "external_id": "{{run}}-d-1",
     "title": "Delete me",
     "markdown": "x"
    },
    "captureBodyAs": "d1"
   },
   {
    "method": "GET",
    "endpoint": "/api/content/{{d1.id}}",
    "captureEtagAs": "d1etag"
   }
  ],
  "method": "DELETE",
  "endpoint": "/api/content/{{d1.id}}",
  "headers": {
   "if-match": "{{etag:d1etag}}"
  },
  "expect": {
   "status": 200,
   "json": {
    "deleted": true
   }
  }
 },
 {
  "name": "deleted entry is gone",
