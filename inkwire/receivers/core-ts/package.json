{
  "name": "inkwire-receiver-core",
  "version": "1.2.1",
  "type": "module",
  "description": "Shared TS core (validate, render, sanitize, read, edit, media, stores) for building an Inkwire receiver.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahoai/inkwire.git",
    "directory": "inkwire/receivers/core-ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "conformance": "npm run build && node test/run-conformance.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.13.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.0",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  }
}
