{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkwire.dev/schema/inkwire-patch.schema.json",
  "title": "Inkwire Content v1 (patch)",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 50
    },
    "cover_image_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https?://"
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https?://"
    },
    "seo": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "noindex": {
          "type": "boolean"
        },
        "og_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "og_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "json_ld": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 20000,
          "description": "One JSON object or array of objects, serialized. Receivers also check that it parses."
        }
      }
    },
    "author": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "categories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 50
    },
    "cover_image_alt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  }
}
